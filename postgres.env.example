# Copy to postgres.env and fill in. Never commit the real file.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dairy
POSTGRES_USER=dairy
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=dairy

# Read-only user Grafana connects with (created by postgres/init/01-roles.sh)
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change-me-too

# Grafana admin login
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-admin
