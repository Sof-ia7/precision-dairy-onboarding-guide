    {
      "id": 4,
      "title": "Average body weight (monthly)",
      "description": "Monthly group mean body weight (PCDart). Less frequent than milk yield.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dairy-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dairy-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT month_start AS time, avg_weight AS \"Avg weight\"\nFROM (\n  SELECT make_date(year::int, month_num::int, 1)::timestamp AS month_start, avg_weight, \"group\"\n  FROM dairy.chapter3_weight_group\n) w\nWHERE \"group\"::text = '$group' AND $__timeFilter(month_start) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lb",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always"
          }
        },
