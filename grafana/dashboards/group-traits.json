  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Average milk yield (80% CI)",
      "description": "Daily mean milk yield of the selected group. Shaded band = 80% t confidence interval (n >= 2).",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dairy-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dairy-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day AS time, avg_daily_yield AS \"Avg milk yield\", ci_lower AS \"CI lower\", ci_upper AS \"CI upper\"\nFROM dairy.chapter3_yield_group_day\nWHERE \"group\"::text = '$group' AND $__timeFilter(day)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lb/day",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CI upper"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "CI lower"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CI lower"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
